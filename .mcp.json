{
	"mcpServers": {
		"worker-mcp": {
			"command": "worker-mcp",
			"env": {
				"WORKER_MCP_ALLOWED_ROOTS": "${user_config.allowed_roots}",
				"WORKER_MCP_PI_PATH": "${user_config.pi_path}",
				"WORKER_MCP_PI_DEFAULT_MODEL": "${user_config.default_model}",
				"WORKER_MCP_LEGACY_TOOLS": "0"
			}
		}
	}
}
